specification {
  element system
  element container
  element person
}

model {
  architect = person 'Architect' {
    description 'Owns the prose: goals, constraints, decisions.'
  }
  agent = person 'LLM agent' {
    description 'Edits model sources between sessions, with no memory of the repository.'
  }

  slarti = system 'slarti' {
    description 'Coordinates LikeC4 and LinkML across the joins neither can see.'

    cli = container 'CLI' {
      description 'typer commands: init, doctor, check, docs, report.'
    }

    runner = container 'Runner' {
      description 'Orders delegated validations and slarti checks into one report.'
    }

    checks = container 'Checks' {
      description 'The ownership, registry and document seams: OWN-*, REG-*, DOC-*.'
    }

    findings = container 'Findings' {
      description 'Stable rule IDs, remedies and the JSON report shape.'
      metadata {
        owns 'Finding, Report, Summary'
      }
    }

    registry = container 'Registry' {
      description 'Reads model/constraints.yaml: the join table between prose and enforcement.'
      metadata {
        owns 'Constraint, Enforcer'
      }
    }

    models = container 'Models' {
      description 'Merges the vocabulary instances of every producer; LinkML via SchemaView, SHACL via rdflib.'
      metadata {
        owns 'Element, Relation'
      }
    }

    docsgen = container 'Document generator' {
      description 'Generates tables and diagram blocks, and injects them between markers.'
      metadata {
        owns 'Region'
      }
    }

    env = container 'Environment gate' {
      description 'Probes every delegated tool and refuses to run outside the supported range.'
      metadata {
        owns 'Probe'
      }
    }

    settings = container 'Config' {
      description 'Reads slarti.toml: paths only, no mirrored settings.'
      metadata {
        owns 'ProjectPaths'
      }
    }

    adapters = container 'Adapters' {
      description 'Built-in producers: LikeC4 via export json, and Mermaid sequence and ER diagrams parsed in Python, translated into vocabulary instances.'
    }

    vocabulary = container 'Vocabulary' {
      description 'The LinkML data contract adapters produce: diagrams, nodes, edges, elements, relations.'
    }

    scaffold = container 'Scaffolder' {
      description 'slarti init: the conventional layout, written once, never overwritten.'
    }
  }

  likec4 = system 'LikeC4' {
    description 'Validates structure and generates diagrams. Invoked via npx --no-install.'
  }
  linkml = system 'LinkML' {
    description 'Validates the schema and generates projections. Invoked as a subprocess.'
  }
  pyshacl = system 'pyshacl' {
    description 'Validates negative fixtures against the hand-written shapes.'
  }

  sources = system 'Model sources' {
    description 'model/arch, model/schema, model/shapes, model/constraints.yaml, docs/architecture.md.'
  }

  architect -> slarti.cli 'runs check and docs'
  agent -> slarti.cli 'runs check --json and applies remedies'
  agent -> sources 'edits'
  architect -> sources 'edits'

  slarti.cli -> slarti.env 'gates on tool versions'
  slarti.cli -> slarti.runner 'runs the checks'
  slarti.cli -> slarti.scaffold 'scaffolds a new project'
  slarti.cli -> slarti.docsgen 'regenerates the document'
  slarti.cli -> slarti.settings 'resolves paths'

  slarti.runner -> slarti.checks 'collects findings'
  slarti.runner -> slarti.registry 'loads the constraints'
  slarti.checks -> slarti.models 'reads both models'
  slarti.checks -> slarti.findings 'emits findings'
  slarti.checks -> pyshacl 'validates one negative fixture per rule'
  slarti.docsgen -> slarti.models 'reads the model'
  slarti.docsgen -> slarti.registry 'reads the rules'
  slarti.docsgen -> likec4 'delegates diagram generation'
  slarti.models -> slarti.vocabulary 'resolves the vocabulary import'
  slarti.docsgen -> slarti.vocabulary 'resolves the vocabulary import'
  slarti.cli -> slarti.vocabulary 'reports the version'
  slarti.models -> slarti.adapters 'reads instances from'
  slarti.adapters -> likec4 'export json'
  slarti.adapters -> sources 'parses Mermaid diagrams in'
  slarti.adapters -> slarti.vocabulary 'emits instances of'
  slarti.models -> linkml 'SchemaView'
  slarti.env -> likec4 'probes the version'
  slarti.env -> linkml 'probes the version'
  slarti.models -> sources 'reads'
  slarti.registry -> sources 'reads'
  slarti.docsgen -> sources 'writes generated regions only'
}

views {
  view index {
    title 'slarti in context'
    include *
  }

  view containers of slarti {
    title 'Inside slarti'
    include *
  }
}
